.screen-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 24px;
    background-color: rgba(0, 0, 0, 1);
}

.screen-root Label {
    color: rgb(235, 235, 235);
}

.config-header {
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.config-hint {
    font-size: 13px;
    color: rgb(170, 170, 170);
    margin-bottom: 16px;
}

/* ---------- Player columns ---------- */

.player-columns {
    flex-direction: row;
    flex-grow: 1;
}

.player-column {
    min-width: 160px;
    margin-right: 12px;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.55);
}

.player-column__header {
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.player-column__slot {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    min-height: 80px;
    background-color: rgba(255, 255, 255, 0.05);
}

/* ---------- Device pool ---------- */

.pool-panel {
    margin-top: 16px;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.55);
}

.pool-panel__header {
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.device-pool {
    flex-direction: row;
    flex-wrap: wrap;
    min-height: 64px;
}

.device-icon {
    width: 72px;
    height: 56px;
    margin: 4px;
    padding: 4px;
    background-color: rgb(60, 60, 60);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Confirm button ---------- */

.confirm-button {
    margin-top: 16px;
    align-self: flex-end;
    padding: 8px 16px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.confirm-button:focus {
    border-color: rgb(255, 196, 0);
    background-color: rgba(255, 196, 0, 0.18);
}

.confirm-button:hover {
    border-color: rgba(255, 196, 0, 0.6);
}
