<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UnityEngine.UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Fate/Scripts/Systems/MainMenu/UI/MainMenu.uss?fileID=7433441132597879392&amp;guid=5fb5af91b7dbc434a92d6879aeedc06c&amp;type=3#MainMenu" />
    <engine:VisualElement name="screen-root" class="screen-root">
        <engine:VisualElement name="init-screen" class="screen init-screen">
            <engine:Button name="join-button" text="Press to Join" class="join-button" />
        </engine:VisualElement>
        <engine:VisualElement name="main-menu-screen" class="screen main-menu-screen">
            <engine:VisualElement name="menu-left-column" class="left-column">
                <engine:Label text="MENU" class="left-column__header" />
                <engine:Button name="mode-quickplay-button" text="Quick Play" class="menu-button" />
                <engine:Button name="mode-custommatch-button" text="Custom Match" class="menu-button" />
                <engine:Button name="mode-host-button" text="Host" class="menu-button" />
                <engine:Button name="mode-join-button" text="Join" double-click-selects-word="true" class="menu-button" />
                <engine:VisualElement class="left-column__spacer" />
                <engine:Button name="configure-controllers-button" text="Configure Controllers" class="menu-button" />
                <engine:Button name="options-button" text="Options" class="menu-button" />
                <engine:Button name="credits-button" text="Credits" class="menu-button" />
            </engine:VisualElement>
            <engine:VisualElement name="menu-right-area" class="right-area">
                <engine:VisualElement name="profile-row" class="profile-row">
                    <engine:VisualElement name="profile-panel" class="profile-panel">
                        <engine:Label text="Players" class="profile-panel__header" />
                        <engine:VisualElement name="profile-list" class="profile-list" />
                        <engine:Button name="add-profile-button" text="+ Add Profile" class="menu-button" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="scene-viewport" class="scene-viewport" />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="login-screen" class="screen login-screen">
            <engine:VisualElement name="login-panel" class="login-panel">
                <engine:Label text="Select a Profile" class="login-panel__header" />
                <engine:VisualElement name="profile-select-list" class="profile-select-list" />
                <engine:VisualElement class="login-panel__divider" />
                <engine:TextField name="new-profile-name-field" label="New Profile" class="new-profile-field" />
                <engine:Button name="create-profile-button" text="Create Profile" class="menu-button" />
                <engine:Button name="login-cancel-button" text="Cancel" class="menu-button login-cancel-button" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
