.lobby-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.6);
}

.lobby-root Label {
    color: rgb(235, 235, 235);
}

/* ---------- Shared button look (mirrors MainMenu's menu-button) ---------- */

.menu-button {
    margin: 4px 0;
    padding: 8px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.menu-button:focus {
    border-color: rgb(255, 196, 0);
    background-color: rgba(255, 196, 0, 0.18);
}

.menu-button:hover {
    border-color: rgba(255, 196, 0, 0.6);
}

/* ---------- Left panel: hosting controls + connection/player list ---------- */

.left-panel {
    width: 50%;
    height: 100%;
    flex-direction: column;
    padding: 16px;
    background-color: rgba(0, 0, 0, 0.35);
}

.hosting-controls {
    flex-direction: row;
}

.hosting-controls > .menu-button {
    flex-grow: 1;
    margin-right: 8px;
}

.player-list {
    flex-grow: 1;
    margin: 12px 0;
}

.back-button {
    align-self: flex-start;
    min-width: 160px;
}

/* ---------- Connection groups: one per incoming connection, grouped with its IP + Kick ---------- */

.connection-group {
    margin-bottom: 8px;
    padding: 6px;
    background-color: rgba(0, 0, 0, 0.55);
}

.connection-group__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.connection-group__ip {
    color: rgb(170, 170, 170);
    font-size: 12px;
}

.connection-group__kick-button {
    padding: 2px 10px;
    margin: 0;
}

.player-entry {
    padding: 2px 4px 2px 12px;
}

/* ---------- Right panel: game setup ---------- */

.right-panel {
    width: 50%;
    height: 100%;
    flex-direction: column;
    padding: 16px;
}

.right-panel__header {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.right-panel__spacer {
    flex-grow: 1;
}

.start-game-button {
    align-self: flex-end;
    min-width: 160px;
}
