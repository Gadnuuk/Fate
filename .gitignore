# This .gitignore file is for Unity projects.
#
# Unity generates a lot of temporary files and folders.
# It is important to ignore these files and folders so that they are not included
# in your Git repository. This keeps your repository clean and efficient.

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Ss]napshotComparisons/
[Pp]ackages/
# Except for the Packages/manifest.json and Packages/packages-lock.json files
![Pp]ackages/manifest.json
![Pp]ackages/packages-lock.json
# Visual Studio cache directory
.vs/
# Gradle cache directory
.gradle/
# Autogenerated VS/Mac/Rider solution and project files
*.csproj
*.unityproj
*.sln
*.suo
*.unop
*.userdetails
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
# Unity-specific files
*.unitypackage
.DS_Store
# Text metadata files (should be tracked)
# *.meta
# Generated text files (should be tracked)
# *.asmdef
# Generated file for Unity Test Runner
TestResults/
# Local History for Unity Collab or Version Control
LocalHistory/